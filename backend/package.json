{
  "name": "trust-check-backend",
  "version": "1.0.0",
  "description": "TrustCheck backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:api": "esbuild src/vercel-entry.ts --bundle --platform=node --format=cjs --outfile=../api/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "esbuild": "^0.21.5"
  }
}